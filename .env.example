
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed;
# this file is the committed template.
#
#   cp .env.example .env
#
# Only the two SUPER_ADMIN_* values have no default and no fallback. Everything
# else is optional — the commented-out lines show the default that applies if
# you leave them out.

# --- the root dashboard account -------------------------------------------------
# Both are required, and only on a database that has no super account yet: on
# startup the app creates this user if no user with the 'super' role exists, and
# refuses to start if there is no super and these are not set — there would be
# no way to sign in to the dashboard.
#
# Once a super exists these are ignored, so changing them here does NOT reset
# the password. Use `python main.py user set-login-password <name> [password]`.
#
# Put a real password here. This account can create and delete every other
# account and issue API keys, so "admin", "password" or your username are all
# credentials an attacker tries first. Anything you commit here is public.
SUPER_ADMIN_USERNAME=your-admin-username
SUPER_ADMIN_PASSWORD=change-me-to-something-long

# --- database --------------------------------------------------------------------
# Leave all of these empty for the default SQLite file at data/sawa9ly.db.
# For a server, set DB_NAME (and usually DB_HOST) and the rest are derived.
# DATABASE_URL wins over every DB_* variable and is used verbatim. Credentials
# are URL-encoded for you when a URL is assembled from parts.
# SQLITE_FILE=data/sawa9ly.db
# DATABASE_URL=postgresql://user:pass@host:5432/sawa9ly
# DB_DRIVER=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sawa9ly
# DB_USER=sawa9ly
# DB_PASSWORD=

# --- http server -----------------------------------------------------------------
# Each is also available as a flag on `serve`: --host, --port, --reload.
# API_HOST=127.0.0.1
# API_PORT=8000
# API_RELOAD=false

# --- logging ---------------------------------------------------------------------
# Silent unless asked for. The default level is WARNING, console only, so a
# normal run prints nothing but errors.
#
# Note that these are only applied when the process that starts the server calls
# configure_logging(); `python main.py serve` does not yet. Until that is fixed,
# set the level in code or run `python src/server.py` to see them.
# LOG_LEVEL=INFO
# LOG_FILE=data/sawa9ly.log
# LOG_FORMAT=text

# Any log line mentioning a password, token, key or cookie has its values
# replaced with [redacted].

# --- dashboard -------------------------------------------------------------------
# Signing key for dashboard tokens. Generated and stored in the database on first
# use, so you normally leave this unset. Set it explicitly on a server so tokens
# survive a database restore or a rebuild.
# DASHBOARD_SECRET=

# --- tracking queue --------------------------------------------------------------
# CRON_INTERVAL is seconds between passes; CRON_DELAY is seconds between products
# inside one pass, because the queue fetches each watched product from the live
# site and going slowly keeps it a good guest.
# CRON_INTERVAL=300
# CRON_DELAY=1.0

# --- telegram --------------------------------------------------------------------
# The bot token, from @BotFather. Leave it unset and the whole Telegram
# integration is simply off: nothing else in the project needs it.
#
# The token is a credential. It is put in the URL of every call the Bot API makes,
# so treat anything holding it — a log, a shell history, a screenshot — as a leak,
# and revoke it from @BotFather if that happens.
# TELEGRAM_BOT_TOKEN=123456789:AA...

# A fallback for the bot's @username, used only if Telegram cannot be reached to
# ask it. Normally unnecessary: the name is read from the token itself, so a link
# can never name a bot the token does not belong to. No leading @.
# TELEGRAM_BOT_NAME=my_notifier_bot

# Telegram notifications are received by polling, not a webhook, so this needs no
# public address, no certificate and no domain. It does need the listener to be
# running, though: `python main.py telegram listen`.
