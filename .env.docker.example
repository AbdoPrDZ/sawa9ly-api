# --- docker ------------------------------------------------------------------
# The environment for the compose files, not for running on the host. Copy this
# to `.env.docker` and edit that; this file is committed and must never hold a
# real value.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker -f docker-compose.sqlite.yml up -d --build
#   docker compose --env-file .env.docker -f docker-compose.postgres.yml up -d --build
#
# `--env-file .env.docker` is required. A service's `env_file:` puts variables
# *into a container*, while the `${...}` in the compose files reads them *from the
# file named by --env-file*. The two never overlap, so a value set here is
# invisible to that interpolation without the flag - and the error says the
# variable is missing rather than unread, which sends you looking in the wrong
# place entirely.
#
# `.env.docker` is not committed - `.gitignore` covers `.env.*` - and it is not
# in the image either, which is why `.dockerignore` lists `.env` explicitly.

# --- required ----------------------------------------------------------------
# Both are required, and compose refuses to start without them. The super account
# is created from these on the first boot against an empty database, and after
# that the password is changed in the dashboard and this value is only a fallback
# for a fresh database. A weak value here is therefore briefly forgotten and
# permanently remembered.

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=

# --- the database ------------------------------------------------------------
# The postgres profile only; ignored entirely by the sqlite one.
#
# `DB_PASSWORD` is the only database password to write. The postgres image insists
# on the name POSTGRES_PASSWORD, and docker-compose.postgres.yml translates one
# into the other, so the value exists once rather than twice - two copies of a
# password in one file is two chances to change one of them.
#
# Any characters are allowed here, including `@`, `/` and `:`. The connection is
# assembled from these discrete variables and the password is url-quoted. That is
# not true of a single DATABASE_URL, which is taken verbatim, which is why the
# compose file does not use one.
#
# Only the password is required. The name and user default to `sawa9ly`, and the
# host and port are set by the compose file because they are facts about the
# deployment rather than decisions: inside the network the database is always at
# `postgres:5432`.
DB_NAME=sawa9ly
DB_USER=sawa9ly
DB_PASSWORD=

# --- the http server ---------------------------------------------------------
# 0.0.0.0, not the 127.0.0.1 the application defaults to. Inside a container the
# loopback interface belongs to the container, so binding to it publishes
# nothing and the port mapping silently goes nowhere. This is the single most
# common reason a containerised service refuses connections.
API_HOST=0.0.0.0
# The port inside the container, and the port the health check uses.
API_PORT=8000
# The port on the host. The compose file publishes this one, bound to the host's
# own loopback: the dashboard is an admin surface with real API keys behind it,
# and reaching it from the network should be a deliberate act.
API_PUBLISHED_PORT=8000

# --- the bot -----------------------------------------------------------------
# The bot container exits with a message naming this variable if it is unset,
# which is better than starting and failing. The queue and the API do not need it.
#
# This is a credential. Anyone holding it can read every message the bot is sent
# and, through it, every account that has linked a chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# --- the queue ---------------------------------------------------------------
# Seconds between passes, and seconds between products within one pass. The delay
# is politeness towards the site rather than anything the site asks for.
CRON_INTERVAL=300
CRON_DELAY=3

# --- logging -----------------------------------------------------------------
# One file per subsystem in /var/log/sawa9ly, inside the container. These files
# are NOT on a volume and do not survive the container being replaced - each of
# the three containers has its own `docker logs`, which is the durable-enough
# copy, and it carries the same lines.
#
# Nothing here is set to a single file. LOG_FILE replaces all five with one, and
# the per-subsystem split is the reason the logging is worth having.
#
# All three locations below are set by the Dockerfile, not here, because they are
# facts about where a Linux system keeps things rather than decisions anyone
# makes per deployment. They are listed so they are not mistaken for local
# development settings - a `.env.docker` that sets them is describing a different
# layout from the one the image uses.
#
#   DATABASE_DIR=/var/lib/sawa9ly   sawa9ly.db, on a volume: the only thing
#                                    here that cannot be recreated
#   LOG_DIR=/var/log/sawa9ly        the five log files, not persisted
#   LOCK_DIR=/tmp/sawa9ly           the locks, which have no meaning once the
#                                    process holding them is gone
#
# Unset, all three fall back to `database/`, `logs/` and `data/` beside the
# source, which is where a local checkout keeps them.
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# --- optional ----------------------------------------------------------------
# Signs dashboard sessions. Generated and stored in the database on first use, so
# it is normally left unset. Set it explicitly when the database is backed up and
# restored elsewhere, so that tokens in people's browsers survive the move.
# DASHBOARD_SECRET=
